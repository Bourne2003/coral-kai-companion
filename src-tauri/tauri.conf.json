{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coral&Kai Companion",
  "version": "0.1.0",
  "identifier": "com.coralkai.companion",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../ui && ../scripts/build_whisper_bridge.sh",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Coral&Kai Companion",
        "width": 440,
        "height": 680,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost https://asset.localhost blob: data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' tauri: asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' tauri: asset: http://asset.localhost https://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost tauri: asset: http://asset.localhost https://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/live2d/**/*",
      "resources/runtime/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
